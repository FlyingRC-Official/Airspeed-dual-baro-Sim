{
  "build": {
    "core": "stm32",
    "cpu": "cortex-m0plus",
    "extra_flags": "-DSTM32G031xx",
    "f_cpu": "16000000L",
    "mcu": "stm32g031g6u6",
    "product_line": "STM32G031xx",
    "variant": "STM32G0xx/G031G(4-6-8)U_G041G(6-8)U"
  },
  "debug": {
    "default_tools": [
      "stlink"
    ],
    "jlink_device": "STM32G031G6",
    "openocd_target": "stm32g0x",
    "svd_path": "STM32G031.svd"
  },
  "frameworks": [
    "stm32cube"
  ],
  "name": "FlyingRC STM32G031G6U6",
  "upload": {
    "maximum_ram_size": 8192,
    "maximum_size": 32768,
    "protocol": "stlink",
    "protocols": [
      "stlink",
      "jlink",
      "blackmagic",
      "cmsis-dap"
    ]
  },
  "url": "https://www.st.com/en/microcontrollers-microprocessors/stm32g031g6.html",
  "vendor": "FlyingRC"
}
